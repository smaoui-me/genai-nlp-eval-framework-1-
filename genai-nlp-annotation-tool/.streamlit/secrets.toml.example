# --- The main endpoint (required) -------------------------------------------
LLM_ENDPOINT = "https://your-endpoint-url"
LLM_API_KEY = "your-api-key"
LLM_DEPLOYMENT_NAME = "gpt-5.4"

# Other deployment names on the SAME endpoint, if your gateway has more than
# one. They appear in the model dropdown; whether they work depends on what
# the gateway actually has deployed.
# LLM_EXTRA_DEPLOYMENTS = ["gpt-4.1-mini", "gpt-4.1-nano"]

# --- Extra providers (optional) ----------------------------------------------
# Anything speaking the OpenAI chat-completions API can be added here, and it
# shows up in the model dropdown and on the Model Comparison page. No code
# changes needed. See utils/model_registry.py for the details.
#
# [providers.openai]
# label    = "OpenAI"
# endpoint = "https://api.openai.com/v1"
# api_key  = "sk-..."
# models   = ["gpt-4.1-nano", "gpt-4.1-mini"]
# supports_logprobs = true
#
# [providers.groq]
# label    = "Groq (free tier)"
# endpoint = "https://api.groq.com/openai/v1"
# api_key  = "gsk_..."
# models   = ["llama-3.3-70b-versatile"]

# --- Local models, free and offline ------------------------------------------
# A local Ollama server is picked up automatically at http://localhost:11434/v1
# and needs no key. Install Ollama, run `ollama pull qwen3:4b`, and it appears
# in the dropdown. Override the defaults here if you use different models:
# OLLAMA_MODELS = "qwen3:4b,llama3.2:3b"
# OLLAMA_ENDPOINT = "http://localhost:11434/v1"
