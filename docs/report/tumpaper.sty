%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% tumpaper.sty — TUM-styled layout for a short scientific paper
%
% Adapted from the official TUM template "Wissenschaftliche Arbeit"
%   (Rechteinhaber: Technische Universitaet Muenchen, https://www.tum.de
%    Gestaltung: ediundsepp Gestaltungsgesellschaft, Muenchen
%    Technische Umsetzung: eWorks GmbH, Frankfurt am Main)
% The original is a German scrbook thesis template. This file keeps the TUM
% look (Helvetica, TUM blue, caption style, heading proportions) but retargets
% it to an English-language 8-page article: scrartcl instead of scrbook,
% paper-sized margins instead of thesis correction margins, and \section as
% the top level instead of \chapter.
%
% Everything layout-related lives here so that the section files under
% sections/ stay pure content — that keeps merge conflicts between the three
% of us confined to the text, not the formatting.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tumpaper}[2026/07/26 TUM-styled article layout for the NLP Lab paper]

% --- Encoding, language, fonts ------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}
\RequirePackage[scaled]{helvet}          % Helvetica — TUM corporate typeface
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{courier}
\RequirePackage{microtype}               % subtle spacing fixes, better justification

% --- Page geometry ------------------------------------------------------------
% The thesis template is single-column with a 40 mm correction margin and 1.5
% line spacing. That is right for a 60-page thesis and wrong for an 8-page
% paper: the same text ran to 26 pages. We keep the TUM look (Helvetica, TUM
% blue, caption style) but use a conference-paper body: two columns, 10 pt,
% single spacing. To go back to one column, drop `twocolumn` from the
% \documentclass options in main.tex and change \linewidth to \textwidth in the
% starred float environments.
% Margins are on the tight side of normal for A4 two-column. The 8-page limit
% counts the bibliography, and the verified references are part of what the
% literature review is for, so the space comes out of the margins rather than
% out of the sources.
\RequirePackage[a4paper,
    top=18mm, bottom=18mm, left=16mm, right=16mm,
    headsep=5mm, footskip=9mm]{geometry}
\setlength{\columnsep}{5.5mm}

\RequirePackage{setspace}
\setstretch{1.0}

% --- Colors -------------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{TUMBlue}{HTML}{0065BD}      % TUM primary blue
\definecolor{TUMDarkBlue}{HTML}{005293}
\definecolor{TUMLightBlue}{HTML}{64A0C8}
\definecolor{TUMOrange}{HTML}{E37222}    % TUM accent (used for highlights)
\definecolor{TUMGreen}{HTML}{A2AD00}
\definecolor{TUMGray}{HTML}{999999}
\definecolor{TUMLightGray}{HTML}{DAD7CB}

% --- Graphics, tables, figures ------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage{rotating}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.15}

% --- Captions (TUM style: bold label, small type, flush left, no separator) ----
\RequirePackage[font=small,labelfont=bf,justification=raggedright,
                singlelinecheck=false,skip=3pt]{caption}
\RequirePackage{subcaption}

% The paper carries five floats. LaTeX's default gap between a float and the
% surrounding text is generous; trimming it recovers close to a page across
% five of them without making anything look crowded.
\setlength{\textfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\floatsep}{7pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}
\setlength{\dbltextfloatsep}{8pt plus 2pt minus 2pt}
\setlength{\dblfloatsep}{7pt plus 2pt minus 2pt}

% --- Diagrams -----------------------------------------------------------------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, fit, backgrounds, calc, shapes.geometric}
% Shared node styles so every diagram in the paper looks like the same diagram.
\tikzset{
    tumbox/.style={draw=TUMBlue, fill=TUMBlue!8, rounded corners=2pt,
                   align=center, font=\footnotesize, inner sep=4pt,
                   minimum height=8mm},
    tumbox2/.style={draw=TUMOrange, fill=TUMOrange!8, rounded corners=2pt,
                    align=center, font=\footnotesize, inner sep=4pt,
                    minimum height=8mm},
    tumdata/.style={draw=TUMGray, fill=TUMLightGray!30, rounded corners=2pt,
                    align=center, font=\footnotesize, inner sep=4pt,
                    minimum height=8mm},
    tumarrow/.style={-{Stealth[length=2mm]}, draw=TUMGray, thick},
    tumlabel/.style={font=\scriptsize\itshape, text=TUMGray}
}

% --- Maths, symbols -----------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{textcomp}

% --- Lists --------------------------------------------------------------------
\RequirePackage{enumitem}
\setlist{itemsep=2pt, topsep=4pt, parsep=0pt}

% --- Code / prompt listings ---------------------------------------------------
\RequirePackage{listings}
\lstdefinestyle{tumlisting}{
    basicstyle=\ttfamily\footnotesize,
    breaklines=true,
    breakatwhitespace=true,
    columns=fullflexible,
    frame=single,
    rulecolor=\color{TUMLightGray},
    backgroundcolor=\color{TUMLightGray!20},
    xleftmargin=6pt, xrightmargin=6pt,
    framexleftmargin=6pt,
    aboveskip=8pt, belowskip=8pt,
    keywordstyle=\color{TUMDarkBlue}\bfseries,
    commentstyle=\color{TUMGray}\itshape,
    stringstyle=\color{TUMGreen!70!black},
    showstringspaces=false,
    tabsize=2
}
\lstset{style=tumlisting}

% --- Headings -----------------------------------------------------------------
\RequirePackage{scrlayer-scrpage}
\setkomafont{disposition}{\normalfont\sffamily\bfseries}
\addtokomafont{section}{\color{TUMBlue}\fontsize{11pt}{13pt}\selectfont}
\addtokomafont{subsection}{\color{TUMDarkBlue}\fontsize{10pt}{12pt}\selectfont}
\addtokomafont{subsubsection}{\fontsize{9.5pt}{11pt}\selectfont}
\addtokomafont{paragraph}{\fontsize{9.5pt}{11pt}\selectfont}
\RedeclareSectionCommand[beforeskip=-1.6ex plus -0.4ex, afterskip=0.7ex]{section}
\RedeclareSectionCommand[beforeskip=-1.3ex plus -0.3ex, afterskip=0.5ex]{subsection}
\RedeclareSectionCommand[beforeskip=-1.0ex plus -0.2ex, afterskip=-1em]{paragraph}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% --- Header / footer ----------------------------------------------------------
\clearpairofpagestyles
\automark[section]{section}
% Unstarred \ihead/\ohead set the running head for `scrheadings` only, so
% \thispagestyle{plain} on page 1 drops the header while keeping the page
% number. The starred forms would apply to both styles and the header would
% reappear on the title page.
\ihead{\footnotesize\color{TUMGray}\runningtitle}
\ohead{\footnotesize\color{TUMGray}\runningauthor}
\ofoot*{\footnotesize\pagemark}
\setkomafont{pageheadfoot}{\normalfont\sffamily\small\color{TUMGray}}
\setkomafont{pagenumber}{\normalfont\sffamily\small}
\RequirePackage{scrlayer-scrpage}
\KOMAoptions{headsepline=0.4pt}
\addtokomafont{headsepline}{\color{TUMLightGray}}
\pagestyle{scrheadings}

% Defaults so the package works even if the document forgets to set them.
\newcommand{\runningtitle}{}
\newcommand{\runningauthor}{}
\newcommand{\setrunningtitle}[1]{\renewcommand{\runningtitle}{#1}}
\newcommand{\setrunningauthor}[1]{\renewcommand{\runningauthor}{#1}}

% --- Bibliography -------------------------------------------------------------
% natbib + BibTeX, numeric citation style, so the document ends with the
% \bibliography{references} call the course asks for.
% IEEE style is numeric with square brackets. natbib in numbers mode drives
% IEEEtran.bst, and keeps \citet/\citep working in the section files.
\RequirePackage[numbers,sort&compress,square,comma]{natbib}
% IEEE calls the list "References"; the course asks for "Bibliography".
% babel rewrites \refname at \begin{document}, so this has to run after that.
\AtBeginDocument{%
  \renewcommand{\refname}{Bibliography}%
  \renewcommand{\bibname}{Bibliography}%
}
% The bibliography is long (a literature review is part of the deliverable) and
% at \small it ran to 2.5 of the 8 permitted pages. Footnotesize with no gap
% between entries brings it back under two columns' worth without making it
% unreadable — it is a reference list, not body text.
\setlength{\bibsep}{0pt plus 0.2ex}
\renewcommand{\bibfont}{\scriptsize}  % Compact enough to keep the bibliography inside the page limit.

% --- Hyperlinks (loaded late, as hyperref wants to be) ------------------------
% Citation numbers in the text link to the bibliography entry. We tried the
% reverse direction too (pagebackref), but the "cited on p. x" notes clutter
% the entries and cost a line each, so they are off.
\RequirePackage[hidelinks,breaklinks=true]{hyperref}
\RequirePackage{bookmark}
\hypersetup{
    colorlinks=true,
    linkcolor=TUMDarkBlue,
    citecolor=TUMDarkBlue,
    urlcolor=TUMDarkBlue,
    pdfborder={0 0 0}
}

\RequirePackage{url}
\RequirePackage{cleveref}
\crefname{section}{Section}{Sections}
\Crefname{section}{Section}{Sections}
\crefname{table}{Table}{Tables}
\crefname{figure}{Figure}{Figures}
\crefname{equation}{Equation}{Equations}

% --- Small semantic helpers used across the section files ---------------------
% Keeping these here means all three of us write the same thing the same way.
\newcommand{\ie}{i.e.\@\xspace}
\newcommand{\eg}{e.g.\@\xspace}
\RequirePackage{xspace}
\newcommand{\method}[1]{\textsc{#1}}          % method names, e.g. \method{zero-shot}
\newcommand{\code}[1]{\texttt{\small #1}}     % file names, fields, label names
\newcommand{\labelname}[1]{\texttt{\small #1}}
\newcommand{\best}[1]{\textbf{#1}}            % best value in a results table

% Highlighted "takeaway" box for findings we want Zeiss to see at a glance.
% The basic library is sufficient for the single static takeaway box. Loading
% `most` also pulls listing, minted, and externalization dependencies that this
% paper never uses and makes clean LaTeX installations unnecessarily fragile.
\RequirePackage{tcolorbox}
\newtcolorbox{takeaway}[1][]{
    colback=TUMBlue!5, colframe=TUMBlue, boxrule=0.6pt, arc=2pt,
    left=6pt, right=6pt, top=5pt, bottom=5pt,
    fonttitle=\bfseries\small, #1
}

% --- Title block spanning both columns ----------------------------------------
% Wraps the \twocolumn[...] optional argument so the title, authors and
% abstract run across the full page width above the two text columns.
\newenvironment{tumtitleblock}{\begin{@twocolumnfalse}}{\end{@twocolumnfalse}}

% --- Abstract environment for scrartcl with TUM look --------------------------
\renewenvironment{abstract}{%
    \begin{center}\small
    \begin{minipage}{0.92\textwidth}
    \textbf{\color{TUMBlue}Abstract.}\enspace\ignorespaces
}{%
    \end{minipage}\end{center}\vspace{1mm}
}

\endinput
