LLM_ENDPOINT=https://your-endpoint-url
LLM_API_KEY=your-api-key
LLM_DEPLOYMENT_NAME=gpt-5.4

# Optional: change the published host port (default: 8501).
APP_PORT=8501

# The default includes local Sentence Transformers support for embedding-based
# routing. Set this to "runtime" only when you want the smaller LLM-only image.
ANNOTATION_TARGET=runtime-embeddings

# Optional local Ollama configuration. In Docker, host.docker.internal reaches
# an Ollama server running on the host machine.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
OLLAMA_MODELS=qwen3:4b
