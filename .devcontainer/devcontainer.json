{
  "name": "GenAI Annotation Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r requirements-dev.txt",
  "postStartCommand": "bash .devcontainer/start-app.sh",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/genai-nlp-annotation-tool:${containerWorkspaceFolder}/src",
    "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "GenAI Annotation Studio",
      "onAutoForward": "openPreview"
    }
  }
}
